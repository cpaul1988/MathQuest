rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function verified() { return request.auth.token.email_verified == true; }
      function shape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schema', 'revision', 'state', 'payload', 'updatedAt'])
          && d.keys().hasAll(['schema', 'revision', 'state', 'payload', 'updatedAt'])
          && d.schema == 1 && d.revision is int && d.revision > 0
          && d.payload is string && d.payload.size() <= 650000
          && d.updatedAt == request.time;
      }
      function active() { return verified() && request.resource.data.state == 'active' && request.resource.data.payload.size() > 0; }
      function tombstone() {
        return request.resource.data.state == 'deleted' && request.resource.data.payload == ''
          && request.auth.token.auth_time > request.time.toMillis() / 1000 - 300;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && shape() && request.resource.data.revision == 1 && (active() || tombstone());
      allow update: if owner() && shape()
        && request.resource.data.revision == resource.data.revision + 1
        && ((resource.data.state == 'active' && active()) || tombstone());
    }
  }
}
